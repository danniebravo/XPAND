# XPAND · API Flask — variables de entorno
# Copia este archivo a .env y ajusta los valores.

# Servidor (run.py). Con FLASK_DEBUG=true se activa el recargador y el depurador: solo en desarrollo.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# Base de datos MySQL (database/init_db.py crea la base "xpand" y sus tablas)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=xpand

# Autenticación
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_HOURS=12

# Clave de las cuentas sembradas por database/init_db.py (solo desarrollo)
SEED_PASSWORD=cambia-esta-clave
